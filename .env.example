# ===========================================================================
# Environment template for the application.
#
#   cp .env.example .env
#   # then edit the values below
#
# docker compose reads .env automatically: for the ${...} substitution in the
# db service, and through "env_file: .env" for the web service.
#
# Never commit .env (it is listed in .gitignore), and never put real
# credentials in this template.
# ===========================================================================

# Host name or address of the PostgreSQL server.
# Purpose: tells the application where to connect.
# Default: localhost
# Example: db (the compose service name), or a managed database host such as
#          mydb.abc123.us-east-1.rds.amazonaws.com
DB_HOST=db

# Port the PostgreSQL server listens on.
# Default: 5432
# Example: 5432
DB_PORT=5432

# Database that holds the watchlist table.
# Default: netflix_db
# Example: netflix_db
DB_NAME=netflix_db

# Database user the application connects as.
# Default: postgres
# Example: postgres
DB_USER=postgres

# Password for DB_USER.
# Default: empty
# Example: change_me_please
# With the bundled db service this value is used when the data volume is
# created for the first time; changing it later does not alter the stored role.
DB_PASSWORD=change_me_please

# TLS mode passed to PostgreSQL (libpq sslmode).
# Default: prefer
# Example: prefer for a local container, require for a managed database such as
#          Amazon RDS, which normally refuses unencrypted connections.
DB_SSLMODE=prefer

# Label shown in the status indicator, so it is clear which environment the
# application is talking to. Any value is accepted; the built-in names are
# Local-Docker, EC2-Lift-and-Shift and AWS-RDS-Refactored. Any other value is
# shown verbatim inside the message.
# Default: Local-Docker
# Example: Local-Docker
DEPLOYMENT_ENV=Local-Docker

# Host port the application is published on. Used by docker compose for the
# web service port mapping; the application itself does not read it.
# Leave unset to publish on 5000. Set another value (for example 5055) if port
# 5000 is already in use on this machine, then open http://localhost:5055.
# A deployment behind a firewall or a cloud security group must allow the same
# port, while the container always listens on 5000.
# Default: 5000
# Example: 5055
# WEB_PORT=5000
