# ==============================================================================
# Netflix Case Study - Application Environment Configuration
# IT457 Cloud Computing | Group 35
# ==============================================================================
# Copy this file to .env and configure for your deployment target:
#   cp .env.example .env
#
# NEVER commit the populated .env file to Git (it is ignored by .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Host name or address of the PostgreSQL server:
#   - For Phase 1 (Local Docker):        DB_HOST=db
#   - For Phase 2 (EC2 Lift-and-Shift): DB_HOST=db
#   - For Phase 3 (Member 3 - AWS RDS): DB_HOST=netflix-cloud-db.c7agmwiwwri7.ap-south-1.rds.amazonaws.com
DB_HOST=db

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Database name
DB_NAME=netflix_db

# Database user:
#   - For Local / EC2 Lift-and-Shift:   DB_USER=postgres
#   - For Member 3 (AWS RDS):            DB_USER=postgresadmin
DB_USER=postgres

# Database password:
#   - For Local / EC2 Lift-and-Shift:   DB_PASSWORD=change_me_please
#   - For Member 3 (AWS RDS):            DB_PASSWORD=<Your-RDS-Master-Password>
DB_PASSWORD=change_me_please

# TLS/SSL Mode:
#   - For Local / EC2 Lift-and-Shift:   DB_SSLMODE=prefer
#   - For Member 3 (AWS RDS):            DB_SSLMODE=prefer
DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# 2. DEPLOYMENT ENVIRONMENT INDICATOR
# ------------------------------------------------------------------------------
# Determines the status pill text and color in the UI:
#   - Local-Docker           -> "Connected to Local Docker DB"
#   - EC2-Lift-and-Shift     -> "Connected to Local Docker DB on EC2"
#   - AWS-RDS-Refactored     -> "Connected to Managed Database: AWS RDS"
#
# Member 3 must set this to: AWS-RDS-Refactored
DEPLOYMENT_ENV=Local-Docker

# ------------------------------------------------------------------------------
# 3. WEB SERVER PORT
# ------------------------------------------------------------------------------
# Published host port (default 5000)
WEB_PORT=5000
